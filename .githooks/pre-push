#!/bin/sh
# Dependabot's half, locally (scripts/check-dependencies.py; Marcel, 2026-10-16, as
# keksdose's): an open Dependabot alert blocks the push; newer minor/patch versions are
# listed, never blocking. It replaces Dependabot's uv version-update PRs.
# Enabled per clone: git config core.hooksPath .githooks. SKIP_DEPENDENCY_CHECK=1 skips it.
# A push of tags or deletes only needs nothing.
tips=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$local_ref" in refs/tags/*) continue ;; esac
  tips="$tips $local_sha"
done
[ -n "$tips" ] || exit 0
uv run --quiet --no-sync python -I scripts/check-dependencies.py </dev/null || exit 1
